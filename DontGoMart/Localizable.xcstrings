        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver полностью и в правильном порядке читает выходные дни и кнопки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
