    "대비를 높이거나 색을 구별하기 어려워도 휴무일을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: a11y.contrast",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spot closed days even with Increase Contrast on or when colors are hard to tell apart."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 휴무일을 알아볼 수 있어요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたときや色の区別がつきにくいときも、休業日がわかります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spot closed days even with Increase Contrast on or when colours are hard to tell apart."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выходные видны, даже если включена повышенная контрастность или трудно различать цвета."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使开启“增强对比度”或不易分辨颜色，也能看清休业日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使開啟「提高對比」或不易分辨顏色，也能看清公休日。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue los días de cierre aunque actives Aumentar contraste o te cueste diferenciar colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkenne Schließtage auch mit „Kontrast erhöhen“ oder wenn dir Farben schwerfallen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repérez les jours de fermeture même avec « Contraste accru » ou si vous distinguez mal les couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosci i giorni di chiusura anche con «Aumenta contrasto» attivo o se fai fatica a distinguere i colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja os dias de fechamento mesmo com Aumentar Contraste ativado ou se for difícil distinguir cores."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูวันปิดได้ชัดเจน แม้เปิดการเพิ่มคอนทราสต์หรือแยกสีได้ยาก"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn nhận ra ngày đóng cửa khi bật Tăng độ tương phản hoặc khi khó phân biệt màu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dny zavření poznáte i se zapnutým zvýšeným kontrastem nebo když hůř rozlišujete barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lukkedage, selv med Øg kontrast slået til, eller hvis du har svært ved at kende forskel på farver."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διακρίνετε τις ημέρες κλεισίματος ακόμη και με ενεργή αύξηση αντίθεσης ή όταν δυσκολεύεστε να ξεχωρίσετε χρώματα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erota sulkupäivät, vaikka Lisää kontrastia olisi päällä tai värien erottaminen olisi vaikeaa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari tutup tetap terlihat jelas meski Tingkatkan Kontras aktif atau kamu sulit membedakan warna."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se stengedager selv med Øk kontrast slått på eller hvis du har vanskelig for å skille farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie sluitingsdagen ook met Contrast verhogen aan of als je kleuren moeilijk kunt onderscheiden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dni zamknięcia widać nawet przy włączonym zwiększonym kontraście lub gdy trudno odróżniać kolory."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se stängningsdagar även med Öka kontrast aktiverat eller om du har svårt att skilja på färger."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrastı Artır açıkken veya renkleri ayırt etmekte zorlansan bile kapalı günleri fark et."
