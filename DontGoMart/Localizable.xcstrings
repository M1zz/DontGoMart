          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser med grøn eller rød, om din butik har åbent denne søndag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείχνει με πράσινο ή κόκκινο αν το κατάστημά σας είναι ανοιχτό αυτή την Κυριακή."
