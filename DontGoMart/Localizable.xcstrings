    "notification_before_body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is closed tomorrow. Today is a good day to shop!"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일 %@ 휴무일입니다. 오늘 장보기 좋은 날이에요!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明日は%@の休業日です。今日が買い物にぴったりの日です!"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is closed tomorrow. Today is a good day to shop!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завтра «%@» закрыт. Сегодня самое время сходить за покупками!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@明天休业。今天正适合去购物！"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@明天公休。今天正適合去採買！"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cierra mañana. ¡Hoy es un buen día para comprar!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat morgen geschlossen. Heute ist ein guter Tag zum Einkaufen!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est fermé demain. Aujourd’hui, c’est le bon jour pour faire vos courses !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ domani è chiuso. Oggi è un buon giorno per fare la spesa!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fecha amanhã. Hoje é um bom dia para fazer compras!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ปิดพรุ่งนี้ วันนี้เหมาะกับการไปซื้อของ!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mai đóng cửa. Hôm nay là ngày thích hợp để đi mua sắm!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ má zítra zavřeno. Dnes je ideální den na nákup!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har lukket i morgen. I dag er det en god dag at handle!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το %@ είναι αύριο κλειστό. Σήμερα είναι καλή μέρα για ψώνια!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on huomenna suljettu. Tänään on hyvä päivä tehdä ostokset!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tutup besok. Hari ini waktu yang tepat untuk belanja!"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er stengt i morgen. I dag er det en god dag å handle!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is morgen gesloten. Vandaag is een goede dag voor boodschappen!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ jutro jest zamknięte. Dziś to dobry dzień na zakupy!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är stängt i morgon. I dag är det en bra dag att handla!"
          }
