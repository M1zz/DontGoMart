    "오늘도 헛걸음을 막아드렸어요.\n보내주신 기부의 감사함을 늘 기억하고 있습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We saved you another wasted trip today.\nWe still remember your generous support."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日も無駄足を防ぎました。\nいただいたご支援への感謝を忘れません。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We saved you another wasted trip today.\nWe still remember your generous support."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы снова уберегли вас от напрасной поездки.\nМы помним вашу щедрую поддержку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天又帮你避免了一次白跑。\n我们一直记得你慷慨的支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天又幫你避免了一次白跑。\n我們一直記得你慷慨的支持。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy te hemos ahorrado otro viaje en balde.\nSeguimos recordando tu generoso apoyo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dir heute wieder eine vergebliche Fahrt erspart.\nWir denken weiter dankbar an deine großzügige Unterstützung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous avons encore évité un trajet pour rien aujourd’hui.\nNous n’oublions pas votre généreux soutien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi ti abbiamo evitato un altro viaggio a vuoto.\nRicordiamo sempre il tuo generoso sostegno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoje evitamos mais uma viagem perdida para você.\nContinuamos lembrando do seu generoso apoio."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้เราช่วยให้คุณไม่ต้องเสียเที่ยวอีกแล้ว\nเรายังจำกำลังใจอันแสนใจดีของคุณได้เสมอ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hôm nay chúng tôi lại giúp bạn khỏi đi uổng công.\nChúng tôi luôn ghi nhớ sự ủng hộ hào phóng của bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnes jsme vám zase ušetřili zbytečnou cestu.\nVaši štědrou podporu si stále pamatujeme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag sparede vi dig for endnu en spildt tur.\nVi husker stadig din generøse støtte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σήμερα σας γλιτώσαμε ξανά από μια άδικη διαδρομή.\nΘυμόμαστε πάντα τη γενναιόδωρη στήριξή σας."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säästimme sinut tänään taas turhalta reissulta.\nMuistamme edelleen anteliaan tukesi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini kami kembali menyelamatkanmu dari perjalanan sia-sia.\nKami selalu mengingat dukunganmu yang murah hati."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag sparte vi deg for enda en bortkastet tur.\nVi husker fortsatt den raushjertede støtten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vandaag hebben we je weer een vergeefse rit bespaard.\nWe denken nog steeds met dank aan je gulle steun."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś znów oszczędziliśmy Ci zbędnej jazdy.\nWciąż pamiętamy o Twoim hojnym wsparciu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dag räddade vi dig från ännu en onödig resa.\nVi minns fortfarande ditt generösa stöd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugün seni bir kez daha boşuna yoldan kurtardık.\nCömert desteğini hep hatırlıyoruz."
          }
        }
      }
    },
