        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver liest Schließtage und Tasten vollständig und in der richtigen Reihenfolge vor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
