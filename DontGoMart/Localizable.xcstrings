          "stringUnit" : {
            "state" : "translated",
            "value" : "ได้ชื่อร้านแล้วแต่ไม่มีข้อมูลวันหยุด ลองใช้ภาพหน้าจอตารางเวลาเปิด หรือเลือกวันด้านล่าง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã lấy được tên nhưng không có thông tin ngày nghỉ. Hãy thử ảnh chụp màn hình giờ mở cửa hoặc chọn ngày bên dưới."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Název se načetl, ale chybí údaje o zavření. Zkuste snímek otevírací doby nebo vyberte dny níže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navnet blev hentet, men der er ingen lukkeoplysninger. Prøv et skærmbillede af åbningstiderne, eller vælg dagene nedenfor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βρέθηκε το όνομα αλλά όχι στοιχεία κλεισίματος. Δοκιμάστε στιγμιότυπο του ωραρίου ή επιλέξτε τις ημέρες παρακάτω."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimi saatiin, mutta sulkemistietoja ei. Kokeile aukioloaikojen kuvakaappausta tai valitse päivät alta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama berhasil didapat, tetapi tidak ada info libur. Coba tangkapan layar jam buka atau pilih hari di bawah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navnet ble hentet, men det mangler stengeinformasjon. Prøv et skjermbilde av åpningstidene, eller velg dagene nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De naam is opgehaald, maar er is geen sluitingsinfo. Probeer een schermafbeelding van de openingstijden of kies de dagen hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa została pobrana, ale brak informacji o zamknięciu. Spróbuj zrzutu ekranu z godzinami otwarcia lub wybierz dni poniżej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namnet hämtades men det saknas stängningsinformation. Prova en skärmavbild av öppettiderna eller välj dagarna nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad alındı ancak kapanış bilgisi yok. Çalışma saatlerinin ekran görüntüsünü dene veya günleri aşağıdan seç."
          }
        }
      }
    },
    "자주 가는 식당의 정기 휴무를 넣어 두면 앞으로 7일 중 쉬는 날을 점으로 알려드려요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the regular closing days of restaurants you visit, and we'll mark closed days in the next 7 days with a dot."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자주 가는 식당의 정기 휴무를 넣어 두면 앞으로 7일 중 쉬는 날을 점으로 알려드려요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく行く飲食店の定休日を入れておくと、今後7日間の休みの日をドットでお知らせします。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the regular closing days of restaurants you visit, and we'll mark closed days in the next 7 days with a dot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте постоянные выходные дни ресторанов, в которые вы ходите, и мы отметим точкой закрытые дни ближайшей недели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入你常去餐厅的固定休息日，我们会用圆点标出未来 7 天里休息的日子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填入你常去餐廳的固定休息日，我們會用圓點標出未來 7 天裡休息的日子。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los días de descanso fijos de los restaurantes a los que sueles ir y marcaremos con un punto los días de cierre de los próximos 7."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage die festen Ruhetage der Restaurants ein, die du besuchst, und wir markieren die Schließtage der nächsten 7 Tage mit einem Punkt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez les jours de repos fixes des restaurants où vous allez et nous marquerons d’un point les jours de fermeture des 7 prochains jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci i giorni di riposo fissi dei ristoranti che frequenti e segneremo con un punto i giorni di chiusura dei prossimi 7."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe os dias de folga fixos dos restaurantes que você frequenta e marcaremos com um ponto os dias de fechamento dos próximos 7."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่วันหยุดประจำของร้านอาหารที่คุณไปบ่อย แล้วเราจะทำจุดบอกวันที่ปิดภายใน 7 วันข้างหน้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập ngày nghỉ cố định của các nhà hàng bạn hay đến, chúng tôi sẽ đánh dấu chấm những ngày nghỉ trong 7 ngày tới."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte pravidelné dny volna restaurací, kam chodíte, a dny zavření v příštích 7 dnech označíme tečkou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj de faste fridage for de restauranter, du besøger, så markerer vi lukkedage inden for de næste 7 dage med en prik."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε τις σταθερές ρεπό των εστιατορίων που επισκέπτεστε και θα σημειώσουμε με τελεία τις ημέρες κλεισίματος των επόμενων 7 ημερών."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää käymiesi ravintoloiden vakiovapaapäivät, niin merkitsemme pisteellä sulkupäivät seuraavien 7 päivän ajalta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan hari libur tetap restoran yang sering kamu kunjungi, dan kami tandai hari tutup dalam 7 hari ke depan dengan titik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg inn de faste fridagene til restaurantene du besøker, så markerer vi stengedagene de neste 7 dagene med en prikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul de vaste vrije dagen in van restaurants waar je komt, en we markeren de sluitingsdagen van de komende 7 dagen met een stip."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz stałe dni wolne restauracji, w których bywasz, a my oznaczymy kropką dni zamknięcia w ciągu najbliższych 7 dni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg in de fasta lediga dagarna för restaurangerna du besöker, så markerar vi stängningsdagarna de kommande 7 dagarna med en prick."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sık gittiğin restoranların sabit tatil günlerini gir; önümüzdeki 7 gün içindeki kapalı günleri nokta ile işaretleyelim."
          }
        }
      }
    },
