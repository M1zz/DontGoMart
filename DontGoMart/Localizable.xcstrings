    "Shows in green/red whether your store is open this Sunday." : {
      "comment" : "Description of the Sunday Open/Closed widget.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows in green/red whether your store is open this Sunday."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주 일요일에 영업하는지 초록·빨강으로 알려줍니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週の日曜日に営業するかどうかを、緑と赤でお知らせします。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows in green/red whether your store is open this Sunday."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зелёным или красным показывает, работает ли ваш магазин в это воскресенье."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用绿色或红色显示你的店铺本周日是否营业。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用綠色或紅色顯示你的店家本週日是否營業。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra en verde o rojo si tu tienda abre este domingo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt in Grün oder Rot, ob dein Markt diesen Sonntag geöffnet hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique en vert ou en rouge si votre magasin est ouvert ce dimanche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra in verde o rosso se il tuo negozio è aperto questa domenica."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra em verde ou vermelho se a sua loja abre neste domingo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงเป็นสีเขียวหรือแดงว่าร้านของคุณเปิดวันอาทิตย์นี้หรือไม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiển thị màu xanh hoặc đỏ cho biết cửa hàng của bạn có mở cửa vào Chủ nhật này không."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
