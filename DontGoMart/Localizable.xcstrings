    "앞으로 7일 동안 쉬는 단골 식당이 없습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of your restaurants close in the next 7 days."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로 7일 동안 쉬는 단골 식당이 없습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後7日間、休みのお気に入りの飲食店はありません。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of your restaurants close in the next 7 days."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ближайшие 7 дней ваши рестораны не закрываются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未来 7 天，你常去的餐厅都不休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未來 7 天，你常去的餐廳都不休息。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguno de tus restaurantes cierra en los próximos 7 días."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keines deiner Restaurants hat in den nächsten 7 Tagen zu."
          }
        }
      }
    },
    "앞으로 7일 중 단골 식당이 쉬는 요일을 점으로 보여줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a dot on days your restaurants are closed in the next 7 days."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로 7일 중 단골 식당이 쉬는 요일을 점으로 보여줘요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
