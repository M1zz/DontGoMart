    "Siri에게 묻거나 단축어로 내 마트가 쉬는 날인지 바로 확인해요." : {
      "comment" : "Roadmap item detail: shortcuts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri or run a shortcut to check right away if your store is closed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 묻거나 단축어로 내 마트가 쉬는 날인지 바로 확인해요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriに聞いたりショートカットを使ったりして、お店が休みかどうかすぐに確認できます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri or run a shortcut to check right away if your store is closed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спросите Siri или запустите команду, чтобы сразу узнать, закрыт ли ваш магазин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问问 Siri，或运行快捷指令，马上知道你的店今天是否休业。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問問 Siri 或執行捷徑，馬上知道你的店今天是否公休。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta a Siri o usa un atajo para saber al instante si tu tienda cierra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag Siri oder starte einen Kurzbefehl und sieh sofort, ob dein Markt geschlossen hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à Siri ou lancez un raccourci pour savoir tout de suite si votre magasin est fermé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a Siri o usa un comando rapido per sapere subito se il tuo negozio è chiuso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte à Siri ou use um atalho para saber na hora se a sua loja está fechada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถาม Siri หรือเรียกใช้คำสั่งลัด เพื่อรู้ทันทีว่าร้านของคุณปิดหรือไม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hỏi Siri hoặc chạy phím tắt để biết ngay cửa hàng của bạn có đóng cửa không."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeptejte se Siri nebo spusťte zkratku a hned zjistíte, jestli má váš obchod zavřeno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg Siri eller kør en genvej, så ser du med det samme, om din butik har lukket."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ρωτήστε τη Siri ή εκτελέστε μια συντόμευση για να δείτε αμέσως αν το κατάστημά σας είναι κλειστό."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy Sirilta tai suorita pikakomento ja näet heti, onko kauppasi suljettu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanya Siri atau jalankan pintasan untuk langsung tahu apakah tokomu tutup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør Siri eller kjør en snarvei, så ser du med en gang om butikken din er stengt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag het aan Siri of voer een opdracht uit en zie meteen of je winkel dicht is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapytaj Siri lub uruchom skrót, aby od razu sprawdzić, czy Twój sklep jest zamknięty."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga Siri eller kör en genväg så ser du direkt om din butik är stängd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri’ye sor veya bir kestirme çalıştır; mağazanın kapalı olup olmadığını hemen öğren."
          }
        }
      }
    },
