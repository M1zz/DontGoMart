    "가장 큰 글자 크기에서도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: a11y.largetext",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even at the largest text sizes, screens rearrange neatly with nothing cut off."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 큰 글자 크기에서도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字サイズを最大にしても、画面が欠けずにきれいに並び替わります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even at the largest text sizes, screens rearrange neatly with nothing cut off."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже при самом крупном тексте экраны аккуратно перестраиваются, и ничего не обрезается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使使用最大字号，页面也会重新排版，内容不会被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使使用最大字級，畫面也會重新排版，內容不會被截斷。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso con el tamaño de texto más grande, las pantallas se reorganizan sin que se corte nada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei der größten Schriftgröße ordnen sich die Bildschirme sauber neu an, ohne dass etwas abgeschnitten wird."
          }
        }
      }
    },
    "고른 마트와 추가한 마트, 알림 설정을 앱 안에서 한 번에 지워요." : {
      "comment" : "Roadmap item detail: data.delete",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase your chosen stores, added stores, and alert settings in the app at once."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 마트와 추가한 마트, 알림 설정을 앱 안에서 한 번에 지워요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだお店、追加したお店、通知の設定をアプリ内でまとめて消去できます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase your chosen stores, added stores, and alert settings in the app at once."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сотрите выбранные и добавленные магазины и настройки уведомлений прямо в приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 内一次清除已选店铺、添加的店铺和通知设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 內一次清除已選店家、新增的店家與通知設定。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra de una vez, dentro de la app, tus tiendas elegidas y añadidas y los ajustes de avisos."
          }
