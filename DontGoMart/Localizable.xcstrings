          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точками отмечены дни ближайшей недели, когда ваши рестораны закрыты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
