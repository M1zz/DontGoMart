    "Siri에게 묻거나 단축어로 내 마트가 쉬는 날인지 바로 확인해요." : {
      "comment" : "Roadmap item detail: shortcuts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri or run a shortcut to check right away if your store is closed."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 묻거나 단축어로 내 마트가 쉬는 날인지 바로 확인해요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siriに聞いたりショートカットを使ったりして、お店が休みかどうかすぐに確認できます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri or run a shortcut to check right away if your store is closed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спросите Siri или запустите команду, чтобы сразу узнать, закрыт ли ваш магазин."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "问问 Siri，或运行快捷指令，马上知道你的店今天是否休业。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "問問 Siri 或執行捷徑，馬上知道你的店今天是否公休。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta a Siri o usa un atajo para saber al instante si tu tienda cierra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag Siri oder starte einen Kurzbefehl und sieh sofort, ob dein Markt geschlossen hat."
          }
        }
      }
    },
