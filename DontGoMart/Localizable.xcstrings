    "가장 큰 글자 크기에서도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: a11y.largetext",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even at the largest text sizes, screens rearrange neatly with nothing cut off."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 큰 글자 크기에서도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字サイズを最大にしても、画面が欠けずにきれいに並び替わります。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even at the largest text sizes, screens rearrange neatly with nothing cut off."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже при самом крупном тексте экраны аккуратно перестраиваются, и ничего не обрезается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使使用最大字号，页面也会重新排版，内容不会被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使使用最大字級，畫面也會重新排版，內容不會被截斷。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso con el tamaño de texto más grande, las pantallas se reorganizan sin que se corte nada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei der größten Schriftgröße ordnen sich die Bildschirme sauber neu an, ohne dass etwas abgeschnitten wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même avec la plus grande taille de texte, les écrans se réorganisent proprement, sans rien tronquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con la dimensione del testo più grande, le schermate si riorganizzano bene senza tagliare nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com o maior tamanho de texto, as telas se reorganizam bem, sem cortar nada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้ตั้งขนาดตัวอักษรใหญ่สุด หน้าจอก็จัดเรียงใหม่อย่างเรียบร้อยโดยไม่มีส่วนใดถูกตัด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngay cả với cỡ chữ lớn nhất, màn hình vẫn sắp xếp lại gọn gàng mà không bị cắt chữ."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani při největší velikosti textu se obrazovky nerozbijí a nic se neořízne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med den største tekststørrelse ordner skærmene sig pænt, uden at noget bliver skåret af."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη και με το μεγαλύτερο μέγεθος κειμένου, οι οθόνες αναδιατάσσονται σωστά χωρίς να κόβεται τίποτα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurimmallakin tekstikoolla näytöt järjestyvät siististi uudelleen, eikä mitään leikkaudu pois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahkan dengan ukuran teks terbesar, tampilan tertata ulang dengan rapi tanpa ada yang terpotong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med største tekststørrelse ordner skjermene seg pent uten at noe kuttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zelfs bij de grootste tekstgrootte worden schermen netjes opnieuw ingedeeld, zonder dat er iets wordt afgekapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet przy największym rozmiarze tekstu ekrany przestawiają się porządnie i nic się nie ucina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även med största textstorleken ordnas skärmarna snyggt om utan att något skärs av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En büyük yazı boyutunda bile ekranlar düzgünce yeniden yerleşir, hiçbir şey kesilmez."
          }
        }
      }
    },
    "고른 마트와 추가한 마트, 알림 설정을 앱 안에서 한 번에 지워요." : {
      "comment" : "Roadmap item detail: data.delete",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase your chosen stores, added stores, and alert settings in the app at once."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 마트와 추가한 마트, 알림 설정을 앱 안에서 한 번에 지워요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだお店、追加したお店、通知の設定をアプリ内でまとめて消去できます。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase your chosen stores, added stores, and alert settings in the app at once."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сотрите выбранные и добавленные магазины и настройки уведомлений прямо в приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 内一次清除已选店铺、添加的店铺和通知设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 App 內一次清除已選店家、新增的店家與通知設定。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra de una vez, dentro de la app, tus tiendas elegidas y añadidas y los ajustes de avisos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lösche ausgewählte und hinzugefügte Märkte sowie Hinweiseinstellungen direkt in der App auf einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacez en une fois, dans l’app, vos magasins choisis et ajoutés ainsi que vos réglages d’alertes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella in un colpo solo, dall’app, i negozi scelti e aggiunti e le impostazioni degli avvisi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apague de uma vez, dentro do app, as lojas escolhidas e adicionadas e os ajustes de alertas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบร้านที่เลือก ร้านที่เพิ่ม และการตั้งค่าการแจ้งเตือนได้ในคราวเดียวภายในแอป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa cùng lúc các cửa hàng đã chọn, đã thêm và cài đặt thông báo ngay trong ứng dụng."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smažte přímo v aplikaci najednou vybrané a přidané obchody i nastavení upozornění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet valgte og tilføjede butikker og indstillinger for påmindelser i appen på én gang."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαγράψτε με μία κίνηση, μέσα στην εφαρμογή, τα επιλεγμένα και τα προστιθέμενα καταστήματα και τις ρυθμίσεις ειδοποιήσεων."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista valitut ja lisätyt kaupat sekä muistutusasetukset kerralla sovelluksesta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus toko yang dipilih, toko yang ditambahkan, dan pengaturan pengingat sekaligus di dalam aplikasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slett valgte og lagt til butikker og varslingsinnstillinger i appen på én gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wis in één keer de gekozen en toegevoegde winkels en de instellingen voor meldingen in de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń naraz wybrane i dodane sklepy oraz ustawienia powiadomień w aplikacji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera valda och tillagda butiker samt påminnelseinställningar i appen på en gång."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğin ve eklediğin mağazaları ve bildirim ayarlarını uygulama içinde tek seferde sil."
          }
        }
      }
    },
