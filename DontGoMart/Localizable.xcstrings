          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont groen of rood of je winkel deze zondag open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na zielono lub czerwono pokazuje, czy Twój sklep jest otwarty w tę niedzielę."
