    "앞으로 7일 동안 쉬는 단골 식당이 없습니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of your restaurants close in the next 7 days."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로 7일 동안 쉬는 단골 식당이 없습니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後7日間、休みのお気に入りの飲食店はありません。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None of your restaurants close in the next 7 days."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ближайшие 7 дней ваши рестораны не закрываются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未来 7 天，你常去的餐厅都不休息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未來 7 天，你常去的餐廳都不休息。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguno de tus restaurantes cierra en los próximos 7 días."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keines deiner Restaurants hat in den nächsten 7 Tagen zu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun de vos restaurants ne ferme dans les 7 prochains jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno dei tuoi ristoranti chiude nei prossimi 7 giorni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum dos seus restaurantes fecha nos próximos 7 dias."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ร้านอาหารของคุณไม่มีร้านไหนปิดใน 7 วันข้างหน้า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có nhà hàng quen nào nghỉ trong 7 ngày tới."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádná z vašich restaurací v příštích 7 dnech nezavírá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af dine restauranter har lukket de næste 7 dage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανένα από τα εστιατόριά σας δεν κλείνει τις επόμενες 7 ημέρες."
