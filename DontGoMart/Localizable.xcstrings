        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別忘了在下一個公休日之前去採買！"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡No olvides hacer la compra antes del próximo día de cierre!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denk daran, vor dem nächsten Schließtag einzukaufen!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’oubliez pas de faire vos courses avant le prochain jour de fermeture !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non dimenticare di fare la spesa prima del prossimo giorno di chiusura!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não se esqueça de fazer as compras antes do próximo dia de fechamento!"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อย่าลืมไปซื้อของก่อนถึงวันปิดครั้งต่อไป!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đừng quên mua sắm trước ngày đóng cửa tiếp theo!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nezapomeňte nakoupit před dalším dnem zavření!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem ikke at handle ind før næste lukkedag!"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μην ξεχάσετε να κάνετε τα ψώνια σας πριν από την επόμενη ημέρα κλεισίματος!"
          }
