    "연중무휴로 나와 있어요. 쉬는 날이 없는 식당이에요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listed as open every day — no regular closed day."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연중무휴로 나와 있어요. 쉬는 날이 없는 식당이에요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年中無休と記載されています。定休日はありません。"
