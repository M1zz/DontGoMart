    "앞으로 7일 중 단골 식당이 쉬는 요일을 점으로 보여줘요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a dot on days your restaurants are closed in the next 7 days."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로 7일 중 단골 식당이 쉬는 요일을 점으로 보여줘요."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後7日間で飲食店が休みの曜日を、ドットで表示します。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows a dot on days your restaurants are closed in the next 7 days."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точками отмечены дни ближайшей недели, когда ваши рестораны закрыты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用圆点显示未来 7 天里你常去的餐厅休息的日子。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用圓點顯示未來 7 天裡你常去的餐廳休息的日子。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra un punto en los días de los próximos 7 en que tus restaurantes cierran."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt einen Punkt an den Tagen der nächsten 7, an denen deine Restaurants geschlossen sind."
