    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is needed to find and recommend nearby stores."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 매장을 찾아 추천하기 위해 위치 정보가 필요합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くのお店を探しておすすめするために、位置情報が必要です。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is needed to find and recommend nearby stores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Геопозиция нужна, чтобы находить и рекомендовать ближайшие магазины."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要位置信息，才能查找并推荐附近的店铺。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要位置資訊，才能尋找並推薦附近的店家。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita la ubicación para buscar y recomendar tiendas cercanas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standort wird benötigt, um Märkte in deiner Nähe zu finden und zu empfehlen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La localisation sert à trouver et recommander les magasins à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione serve per trovare e consigliare i negozi vicini."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização é necessária para encontrar e recomendar lojas próximas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้ตำแหน่งเพื่อค้นหาและแนะนำร้านใกล้เคียง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần vị trí để tìm và gợi ý các cửa hàng gần bạn."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poloha je potřeba k nalezení a doporučení obchodů poblíž."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to save closing-day card photos and videos to your library."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴무 알림 카드 사진·동영상을 앨범에 저장하기 위해 필요합니다."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "休業のお知らせカードの写真や動画をアルバムに保存するために必要です。"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needed to save closing-day card photos and videos to your library."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужно, чтобы сохранять в медиатеку фото и видео карточек о выходных днях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于把休业提醒卡片的照片和视频保存到相册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於將公休提醒卡片的照片與影片儲存到相簿。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se necesita para guardar en tu fototeca las fotos y los vídeos de las tarjetas de cierre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird benötigt, um Fotos und Videos der Schließkarten in deiner Mediathek zu sichern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour enregistrer dans votre photothèque les photos et vidéos des cartes de fermeture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve per salvare nella libreria le foto e i video delle schede di chiusura."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para salvar na sua fototeca as fotos e os vídeos dos cartões de fechamento."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องใช้เพื่อบันทึกรูปและวิดีโอของการ์ดแจ้งวันปิดลงในคลังรูปภาพ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cần để lưu ảnh và video của thẻ thông báo đóng cửa vào thư viện ảnh."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potřebné k uložení fotek a videí karet o zavření do vaší knihovny."
          }
        }
      }
    }
